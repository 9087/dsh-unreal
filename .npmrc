# Keep every pnpm write inside the project, so no install reaches a global store.
store-dir=.pnpm-store
cache-dir=.pnpm-cache

# pnpm fails the whole install with ERR_PNPM_IGNORED_BUILDS when a dependency has
# a skipped build script. esbuild ships a platform-specific optional package and
# resolves its binary from there, so a skipped postinstall is harmless here.
strict-dep-builds=false
